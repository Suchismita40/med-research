// Private Medical Research Data Exchange Smart Contract
// Midnight Confidential Credentials & Data Access Proofs

pragma language_version 0.23;

import CompactStandardLibrary;

export enum State {
  NONE,
  REQUESTED,
  GRANTED,
  REVOKED
}

// =============================================================================
// PUBLIC LEDGER STATE (Transparent On-Chain State)
// =============================================================================
export ledger state: State;
export ledger datasetTitle: Maybe<Opaque<"string">>;
export ledger datasetCategory: Maybe<Opaque<"string">>;
export ledger datasetCount: Counter;
export ledger activeResearcherPk: Bytes<32>;
export ledger auditLogCount: Counter;
export ledger lastProofHash: Bytes<32>;
export ledger sequence: Counter;
export ledger owner: Bytes<32>;
export ledger maxAccessLimit: Counter;
export ledger accessCount: Counter;

constructor() {
  state = State.NONE;
  datasetTitle = none<Opaque<"string">>();
  datasetCategory = none<Opaque<"string">>();
  datasetCount.increment(1);
  auditLogCount.increment(0);
  lastProofHash = pad(32, "init");
  sequence.increment(1);
  maxAccessLimit.increment(5);
  accessCount.increment(0);
}

// =============================================================================
// PRIVATE WITNESS STATE (Kept Secret Within Prover Browser State)
// =============================================================================
witness localSecretKey(): Bytes<32>;
witness medicalCredentialSecret(): Bytes<32>;
witness patientRecordKey(): Bytes<32>;

// =============================================================================
// CIRCUITS & DISCLOSE() PRIVACY MODEL
// =============================================================================

export circuit registerDataset(title: Opaque<"string">, category: Opaque<"string">): [] {
  assert(state == State.NONE || state == State.REVOKED, "Dataset slot busy");
  owner = disclose(publicKey(localSecretKey(), sequence as Field as Bytes<32>));
  datasetTitle = disclose(some<Opaque<"string">>(title));
  datasetCategory = disclose(some<Opaque<"string">>(category));
  state = State.NONE;
  datasetCount.increment(1);
}

export circuit requestAccess(datasetId: Bytes<32>): [] {
  assert(state == State.NONE || state == State.REVOKED, "Cannot request access when access active or requested");
  const credVal = medicalCredentialSecret();
  assert(credVal != pad(32, ""), "Invalid private medical credential");
  activeResearcherPk = disclose(publicKey(localSecretKey(), datasetId));
  state = State.REQUESTED;
}

export circuit grantPermission(datasetId: Bytes<32>, researcherPk: Bytes<32>): [] {
  assert(state == State.REQUESTED, "No pending research access request to grant");
  assert(owner == publicKey(localSecretKey(), sequence as Field as Bytes<32>), "Only hospital dataset owner can grant permission");
  assert(activeResearcherPk == researcherPk, "Researcher public key mismatch");
  state = State.GRANTED;
}

export circuit submitAccessProof(datasetId: Bytes<32>, patientRecordHash: Bytes<32>): [] {
  assert(state == State.GRANTED, "Access permission not granted for dataset");
  assert(activeResearcherPk == publicKey(localSecretKey(), datasetId), "Caller is not authorized researcher");
  assert(accessCount < maxAccessLimit, "Dataset access quota exceeded");
  
  const pKey = patientRecordKey();
  assert(pKey != pad(32, ""), "Empty patient record key");

  lastProofHash = disclose(persistentHash<Vector<3, Bytes<32>>>([patientRecordHash, pKey, activeResearcherPk]));
  auditLogCount.increment(1);
  accessCount.increment(1);
}

export circuit renewAccessQuota(datasetId: Bytes<32>, additionalQuota: Uint<32>): [] {
  assert(state == State.GRANTED, "Access must be active to renew quota");
  assert(owner == publicKey(localSecretKey(), sequence as Field as Bytes<32>), "Only hospital dataset owner can renew quota");
  maxAccessLimit.increment(disclose(additionalQuota as Uint<16>));
}

export circuit revokeAccess(datasetId: Bytes<32>): [] {
  assert(state == State.GRANTED || state == State.REQUESTED, "Cannot revoke inactive dataset access");
  assert(owner == publicKey(localSecretKey(), sequence as Field as Bytes<32>), "Only hospital admin can revoke access");
  state = State.REVOKED;
  sequence.increment(1);
}

export circuit publicKey(sk: Bytes<32>, sequence: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "medex:pk:"), sequence, sk]);
}
